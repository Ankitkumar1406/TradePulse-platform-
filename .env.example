# ---- database (PostgreSQL 17 via Prisma) ----
# Local dev uses a userspace cluster under ./pgdata (scripts/pg-ctl.sh start).
# Create the schema with: npm run db:push. Seed the DB: bun run db:seed
DATABASE_URL=postgresql://tradepulse:tradepulse@127.0.0.1:5432/tradepulse?connection_limit=8&pool_timeout=30

# ---- admin ----
# Comma-separated emails allowed to force a sync past the 4-hour hard gate
# (POST /api/sync { force: true }).
ADMIN_EMAILS=you@example.com
