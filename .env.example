# ---- database (SQLite via Prisma) ----
# Path to the SQLite database file. Create the schema with: npm run db:push
DATABASE_URL=file:./db/custom.db?connection_limit=8&pool_timeout=30

# ---- NextAuth ----
# Public URL of the deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# ---- Cashfree payments (optional) ----
# When these are set, Pro subscriptions become live (UPI Autopay / e-mandate).
# Without them the app runs normally and the subscribe step stays in test mode.
# Use https://api.cashfree.com for production, https://api-sandbox.cashfree.com for sandbox.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_DOMAIN=https://api-sandbox.cashfree.com
